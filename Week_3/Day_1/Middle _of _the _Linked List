struct ListNode* middleNode(struct ListNode* head)
{
    int totalNodes = 0;
    struct ListNode *ptr = head;
    while (ptr != NULL)
    {
        totalNodes++;
        ptr = ptr->next;
    }
    int middleIndex = totalNodes / 2;
    ptr = head
    while (middleIndex > 0)
    {
        ptr = ptr->next;
        middleIndex--;
    }
    return ptr;
}
