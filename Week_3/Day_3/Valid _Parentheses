bool isValid(char* s)
{
    char stack[10000];
    int top = -1;

    for(int i = 0; s[i] != '\0'; i++)
    {
        if(s[i] == '(' || s[i] == '{' || s[i] == '[')
        {
            top++;
            stack[top] = s[i];
        }
        else
        {
            if(top == -1)
            {
                return false;
            }

            char ch = stack[top];
            top--;

            if((s[i] == ')' && ch != '(') ||
               (s[i] == '}' && ch != '{') ||
               (s[i] == ']' && ch != '['))
            {
                return false;
            }
        }
    }

    if(top == -1)
    {
        return true;
    }

    return false;
}
