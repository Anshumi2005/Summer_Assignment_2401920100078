int largestRectangleArea(int* heights, int heightsSize) {
    int maxArea = 0;

    for(int i = 0; i < heightsSize; i++)
    {
        int minHeight = heights[i];

        for(int j = i; j < heightsSize; j++)
        {
            if(heights[j] < minHeight)
            {
                minHeight = heights[j];
            }

            int width = j - i + 1;
            int area = minHeight * width;

            if(area > maxArea)
            {
                maxArea = area;
            }
        }
    }

    return maxArea;
}
