void sortString(char *str) {
    int len = strlen(str);

    for (int i = 0; i < len - 1; i++) {
        for (int j = i + 1; j < len; j++) {
            if (str[i] > str[j]) {
                char temp = str[i];
                str[i] = str[j];
                str[j] = temp;
            }
        }
    }
}
char*** groupAnagrams(char** strs, int strsSize,
                      int* returnSize,
                      int** returnColumnSizes) {
    char ***groups = (char ***)malloc(strsSize * sizeof(char **));
    *returnColumnSizes = (int *)malloc(strsSize * sizeof(int));
    int visited[10000] = {0};
    int groupCount = 0;
    for (int i = 0; i < strsSize; i++) {
        if (visited[i])
            continue
        groups[groupCount] = (char **)malloc(strsSize * sizeof(char *))
        int size = 0
        groups[groupCount][size++] = strs[i];
        visited[i] = 1;
        char base[101];
        strcpy(base, strs[i]);
        sortString(base);
        for (int j = i + 1; j < strsSize; j++) {
            if (visited[j])
                continue;
            char temp[101];
            strcpy(temp, strs[j]);
            sortString(temp);
            if (strcmp(base, temp) == 0) {
                groups[groupCount][size++] = strs[j];
                visited[j] = 1;
            }
        }
        (*returnColumnSizes)[groupCount] = size;
        groupCount++
    }
    *returnSize = groupCount;
    return groups;
}
