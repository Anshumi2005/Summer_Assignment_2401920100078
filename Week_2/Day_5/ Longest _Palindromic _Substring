char* longestPalindrome(char* s) {
    int n = strlen(s);
    if (n == 0) {
        char *ans = (char *)malloc(1);
        ans[0] = '\0'
        return ans;
    }
    int start = 0;
    int maxLen = 1;
    for (int i = 0; i < n; i++) {
        for (int j = i; j < n; j++) {
            int left = i;
            int right = j;
            int isPal = 1
